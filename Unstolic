	<script>
		(function() {
			const key = 'unstolic_cookie_consent';
			const banner = document.getElementById('cookie-banner');
			if (!banner) return;
			function setConsent(choice) {
				const payload = { necessary: true };
				if (choice === 'accept') {
					payload.analytics = true;
					payload.marketing = true;
				} else if (choice === 'reject') {
					payload.analytics = false;
					payload.marketing = false;
				} else {
					payload.analytics = !!document.querySelector('[name="analytics"]').checked;
					payload.marketing = !!document.querySelector('[name="marketing"]').checked;
				}
				localStorage.setItem(key, JSON.stringify(payload));
				banner.classList.remove('visible');
			}
			const saved = localStorage.getItem(key);
			if (saved) {
				banner.classList.remove('visible');
				return;
			}
			banner.classList.add('visible');
			banner.querySelectorAll('[data-cookie-choice]').forEach(function(button) {
				button.addEventListener('click', function() {
					const choice = button.getAttribute('data-cookie-choice');
					if (choice === 'customise') {
						banner.classList.toggle('expanded');
						return;
					}
					setConsent(choice);
				});
			});
		})();
	</script>
	<script>
		(function() {
			const scales = [0.875, 1, 1.125, 1.25];
			const settings = document.querySelector('.text-settings');
			if (!settings) return;
			const output = settings.querySelector('output');
			const decrease = settings.querySelector('[data-text-size="decrease"]');
			const increase = settings.querySelector('[data-text-size="increase"]');
			const key = 'unstolic_text_scale';
			let scale = Number(localStorage.getItem(key));
			if (!scales.includes(scale)) scale = 1;
			function applyScale(nextScale) {
				scale = nextScale;
				document.documentElement.style.fontSize = (scale * 100) + '%';
				localStorage.setItem(key, String(scale));
				output.textContent = Math.round(scale * 100) + '%';
				decrease.disabled = scale === scales[0];
				increase.disabled = scale === scales[scales.length - 1];
			}
			settings.addEventListener('click', function(event) {
				const button = event.target.closest('[data-text-size]');
				if (!button) return;
				const action = button.getAttribute('data-text-size');
				if (action === 'reset') {
					applyScale(1);
				} else {
					const index = scales.indexOf(scale);
					applyScale(scales[index + (action === 'increase' ? 1 : -1)]);
				}
			});
			applyScale(scale);
		})();
	</script>
	<script>
		(function() {
			const body = document.body;
			if (!body) return;
			const startTransition = function() {
				requestAnimationFrame(function() {
					requestAnimationFrame(function() {
						body.classList.add('page-ready');
					});
				});
			};
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', startTransition, { once: true });
			} else {
				startTransition();
			}
			document.querySelectorAll('a[href]').forEach(function(link) {
				const href = link.getAttribute('href');
				if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || link.target === '_blank') return;
				const isSameOrigin = !link.href || link.origin === window.location.origin || link.protocol === 'file:';
				if (!isSameOrigin) return;
				link.addEventListener('click', function(event) {
					if (event.defaultPrevented || link.hasAttribute('download')) return;
					event.preventDefault();
					body.classList.remove('page-ready');
					body.classList.add('page-exit');
					setTimeout(function() {
						window.location.href = href;
					}, 180);
				});
			});
		})();
	</script>
